# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=False
SECRET_KEY=change-me-to-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Database
POSTGRES_USER=nachalo_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nachalo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Frontend
FRONTEND_URL=http://localhost:8080
VITE_API_BASE_URL=/api/v1

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
SECURE_SSL_REDIRECT=False

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7

# AI — классификация + рекомендации (обязателен хотя бы один)
AI_CLASSIFIER_PROVIDER=openrouter
AI_CLASSIFIER_MODEL=openai/gpt-oss-120b:free
AGGREGATOR_AUTO_PUBLISH_CONFIDENCE=0.75
AGGREGATOR_SPAM_THRESHOLD=0.5

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Grok (https://console.x.ai/)
# GROK_API_KEY=
# GROK_API_BASE=https://api.x.ai/v1
