# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production-12345678901234567890
ALLOWED_HOSTS=localhost,127.0.0.1,backend,example.com

# Database
POSTGRES_USER=nachalo_user
POSTGRES_PASSWORD=nachalo_secure_password_change_this
POSTGRES_DB=nachalo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration (Gmail example, change to your provider)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# CORS and Security
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7

# AWS S3 (optional, для загрузки файлов)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# Sentry (для мониторинга ошибок)
# SENTRY_DSN=

# AI — Anthropic Claude (рекомендации мероприятий волонтёрам + AI-классификация
# объявлений агрегатора). Без ключа рекомендации и классификация не работают.
# ANTHROPIC_API_KEY=

# OpenAI — альтернативный провайдер для AI-классификации агрегатора
# (AI_CLASSIFIER_PROVIDER=openai)
# OPENAI_API_KEY=


# Пороги модерации агрегатора: авто-публикация для доверенных источников и
# отсев спама
# AGGREGATOR_AUTO_PUBLISH_CONFIDENCE=0.75
# AGGREGATOR_SPAM_THRESHOLD=0.5

# Timepad API (https://dev.timepad.ru/) — опционально, регистрация токена
# доступна только для РФ
# TIMEPAD_API_TOKEN=